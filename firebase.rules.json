{
  "rules": {
    ".read": false,
    ".write": false,
    "kitchenUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false,
        ".validate": "newData.isBoolean()"
      }
    },
    "sessions": {
      "$sessionId": {
        ".read": false,
        ".write": false,
        "meta": {
          ".read": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
          ".write": false,
          "archived": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".validate": "newData.isBoolean()"
          },
          "archivedAtMs": {
            ".read": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".write": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".validate": "newData.isNumber()"
          },
          "archivedBy": {
            ".read": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".write": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "updatedAtMs": {
            ".read": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".write": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
            ".validate": "newData.isNumber()"
          },
          "lastNumber": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('sessions').child($sessionId).child('meta').child('archived').val() != true && ((!data.exists() && newData.val() >= 18) || (data.exists() && newData.val() == data.val() + 1))",
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "orders": {
          ".read": "auth != null && root.child('kitchenUsers').child(auth.uid).val() == true",
          ".write": false,
          ".indexOn": ["number", "status", "guestUid", "createdAtMs"],
          "$orderId": {
            ".read": "auth != null && (!data.exists() || root.child('kitchenUsers').child(auth.uid).val() == true || data.child('guestUid').val() == auth.uid)",
            ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('sessions').child($sessionId).child('meta').child('archived').val() != true && newData.child('id').val() == $orderId && newData.child('clientRequestId').val() == $orderId && newData.child('sessionId').val() == $sessionId && newData.child('guestUid').val() == auth.uid && newData.child('status').val() == 'received') || (data.exists() && newData.exists() && root.child('kitchenUsers').child(auth.uid).val() == true && newData.child('id').val() == data.child('id').val() && newData.child('clientRequestId').val() == data.child('clientRequestId').val() && newData.child('sessionId').val() == data.child('sessionId').val() && newData.child('guestUid').val() == data.child('guestUid').val() && newData.child('number').val() == data.child('number').val() && newData.child('guestName').val() == data.child('guestName').val() && newData.child('sauce').val() == data.child('sauce').val() && newData.child('toppings').val() == data.child('toppings').val() && newData.child('createdAtMs').val() == data.child('createdAtMs').val()))",
            ".validate": "newData.hasChildren(['id', 'sessionId', 'clientRequestId', 'guestUid', 'number', 'guestName', 'sauce', 'status', 'createdAtMs', 'updatedAtMs'])",
            "id": {
              ".validate": "newData.isString() && newData.val() == $orderId && newData.val().length >= 8 && newData.val().length <= 80"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val() == $sessionId"
            },
            "clientRequestId": {
              ".validate": "newData.isString() && newData.val() == $orderId && newData.val().length >= 8 && newData.val().length <= 80"
            },
            "guestUid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "number": {
              ".validate": "newData.isNumber() && newData.val() >= 18"
            },
            "guestName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            },
            "toppings": {
              ".validate": "newData.childrenCount() <= 3",
              "pickles": {
                ".validate": "newData.isBoolean() && newData.val() == true"
              },
              "jalapenos": {
                ".validate": "newData.isBoolean() && newData.val() == true"
              },
              "onions": {
                ".validate": "newData.isBoolean() && newData.val() == true"
              },
              "$other": {
                ".validate": false
              }
            },
            "sauce": {
              ".validate": "newData.isString() && (newData.val() == 'bigmac' || newData.val() == 'giant' || newData.val() == 'mayo' || newData.val() == 'ketchup' || newData.val() == 'spicy')"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() == 'received' || newData.val() == 'preparing' || newData.val() == 'ready' || newData.val() == 'served' || newData.val() == 'cancelled')"
            },
            "createdAtMs": {
              ".validate": "newData.isNumber()"
            },
            "updatedAtMs": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
